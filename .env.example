# --- MySQL (use a dedicated SELECT-only user, see README) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=mcp_ro
DB_PASSWORD=change-me
DB_NAME=your_database

# --- MCP server ---
# Transport: "http" (default) or "stdio"
MCP_TRANSPORT=http
# Bind address. Keep 127.0.0.1 unless you know you need otherwise.
MCP_HOST=127.0.0.1
MCP_PORT=3000
# Required for http transport. Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=

# --- Query limits ---
QUERY_MAX_ROWS=200
QUERY_TIMEOUT_MS=5000
MAX_RESPONSE_CHARS=50000
